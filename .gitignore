# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs internes
/docs-syoul/

# CI reports (SBOM, Trivy)
/.reports/
.env.deploy

# Réglages locaux de Claude Code — contiennent des règles de permission qui citent
# des commandes complètes : adresses de serveur, chemins, et parfois des secrets
# collés en clair. Le dépôt est public : la protection doit vivre ICI et pas
# seulement dans le ~/.config/git/ignore de la machine qui a créé le fichier.
.claude/settings.local.json
.claude/*.local.json
