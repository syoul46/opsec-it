# Vhost Caddy du site opsec-it.fr — CX23 Nuremberg.
#
# Fichier séparé et chargé par `import conf.d/*.caddy` depuis /etc/caddy/Caddyfile :
# maeva documente `install -m644 .../deploy/Caddyfile /etc/caddy/Caddyfile`, qui écrase
# le fichier entier. Tant que chaque site vit dans son propre fichier de conf.d, un
# redéploiement de maeva ne peut pas emporter le vhost du site.
#
# Déployer :
#   install -m644 /opt/opsec-it/deploy/opsec-it.caddy /etc/caddy/conf.d/
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Le certificat Let's Encrypt est obtenu et renouvelé automatiquement, à condition que
# le DNS d'opsec-it.fr et de www pointe sur cette machine.
#
# L'adresse IP du serveur n'est volontairement écrite nulle part dans ce dépôt,
# qui est public : la garder hors du code ne protège rien en soi (un DNS suffit à
# la retrouver) mais évite de l'associer à un inventaire de la stack, des chemins
# et des ports. À conserver dans ~/.ssh/config, pas ici.

opsec-it.fr {
	# Next.js écoute en clair sur la boucle locale uniquement (cf. deploy/docker-compose.yml).
	reverse_proxy 127.0.0.1:3000

	# zstd d'abord : Caddy négocie le meilleur encodage accepté par le client et
	# retombe sur gzip pour les vieux navigateurs. Fonctionne parce que Next ne
	# compresse plus en amont (`compress: false` dans next.config.ts) — sinon le
	# corps arriverait déjà gzippé et zstd ne serait jamais utilisé.
	encode zstd gzip

	header {
		# HSTS reste ici : c'est une politique du terminateur TLS, pas de l'app.
		#
		# Ajouter `; preload` engage le domaine dans la liste préchargée des
		# navigateurs — quasi irréversible (des mois de délai pour en sortir) et
		# contraignant pour TOUS les sous-domaines actuels et futurs
		# d'opsec-it.fr. À décider consciemment, pas par réflexe de scoring.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Les autres en-têtes (CSP, Permissions-Policy, X-Frame-Options, nosniff,
	# Referrer-Policy, COOP) sont émis par l'application : cf. `headers()` dans
	# next.config.ts. Ne pas les redéclarer ici — `header` remplace la valeur
	# amont sans prévenir, et on se retrouverait avec deux sources de vérité.

	log {
		output file /var/log/caddy/opsec-it.log
		format console
	}
}

# Un seul nom canonique : le sitemap, robots.txt et metadataBase codent tous
# https://opsec-it.fr en dur (app/sitemap.ts, app/robots.ts, app/[locale]/layout.tsx).
# Servir le site sous www en plus créerait du contenu dupliqué contredisant le sitemap.
www.opsec-it.fr {
	redir https://opsec-it.fr{uri} permanent
}
